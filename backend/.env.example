DATABASE_URL=postgresql+psycopg://smartrecipe:smartrecipe@localhost:5433/smartrecipe
TEST_DATABASE_URL=postgresql+psycopg://smartrecipe:smartrecipe@localhost:5433/smartrecipe_test
JWT_SECRET_KEY=replace-with-a-random-secret-generated-locally
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Needed for live search and for loading recipes (python -m scripts.ingest).
# Leave blank to run without them; live search then returns stored results only.
LANGSEARCH_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Live search settings (all optional, defaults shown)
LIVE_SEARCH_ENABLED=true
LIVE_SEARCH_THIN_THRESHOLD=5
LIVE_SEARCH_MAX_PAGES=6
LIVE_SEARCH_TARGET=3
LIVE_SEARCH_PARSE_DELAY=1.0
LIVE_SEARCH_WORKERS=2
LIVE_SEARCH_CACHE_HOURS=24